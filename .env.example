HOST=127.0.0.1
PORT=41777
# 多数据源配置 (JSON 数组格式，替代旧的 OPENCODE_DB_PATH)
# 每个数据源需要 label (标识), path (SQLite 路径), enabled (是否启用)
DATASOURCES=[{"label":"opencode","path":"C:\\Users\\<your-user>\\.local\\share\\opencode\\opencode.db","enabled":true},{"label":"hermes","path":"\\\\wsl$\\Ubuntu\\home\\<your-user>\\.hermes\\state.db","enabled":true}]
# 分析缓存库 (可重建)
ANALYTICS_DB_PATH=./.run/analytics.db
# 定价库 (持久化，使用绝对路径)
PRICING_DB_PATH=C:/Users/<your-user>/.local/share/opencode-cost-observatory/pricing.db
# 优先使用本地令牌文件
DASHBOARD_TOKEN_FILE=./.run/dashboard.token
# 备选：明文令牌
# DASHBOARD_TOKEN=replace-with-local-token
